# Local editor/agent state
.claude/settings.local.json
.DS_Store

# TLC model checker artifacts
tla2tools.jar
states/
*.st

# Go build output (never a bare "krilld" pattern — it swallows cmd/krilld/)
/bin/
/dist/
/krilld
m1-gates/krilld
*.test

# Node (MCP server)
mcp/node_modules/
mcp/dist/

# M2 gate artifacts
m2-gates/results/

# M4 gate artifacts. results/ holds real browser session cookies during a run
# (F1 saves one so F2 and F3 can reuse it) — never commit it.
m4-gates/results/

# Big binary artifacts that never belong in git
*.ext4
*.img
vmstate
mem
*.log
m1-gates/results/
m3-gates/results/
